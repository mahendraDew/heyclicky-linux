# Copy to .env and fill in the keys you actually use. .env is git-ignored.
# Only the OpenRouter key is required for the default setup.

# OpenRouter (default provider)
OPENROUTER_GEMMA_API_KEY=sk-or-v1-...

# Groq (optional: fast text models, Whisper speech-to-text)
GROQ_API_KEY=gsk_...

# Google Gemini (optional: fast free vision model)
GEMINI_API_KEY=AIza...

# Local Ollama needs no key
# OLLAMA_HOST=http://127.0.0.1:11434
